# Configuración de Kozmok. Copia este archivo como .env (en esta misma
# carpeta) y pon tus valores. El .env NO se sube a GitHub (.gitignore).

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kozmok
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_contraseña

# --- Servidor ---
PORT=3000
# 0.0.0.0 = también se abre desde celulares en la misma red Wi-Fi
# (la consola muestra la dirección). 127.0.0.1 = solo esta computadora.
HOST=0.0.0.0

# --- Sesiones ---
SESION_HORAS_CLIENTE=168        # 7 días
SESION_HORAS_EQUIPO=8
INACTIVIDAD_MIN_CLIENTE=2880    # se cierra tras 2 días sin uso
INACTIVIDAD_MIN_EQUIPO=120      # el panel se cierra tras 2 horas sin uso
# Pon 1 si la tienda se sirve por HTTPS (la cookie viaja solo cifrada)
COOKIE_SEGURA=0

# --- Fuerza bruta ---
MAX_FALLOS_CUENTA=5             # contraseñas equivocadas seguidas antes de bloquear la cuenta
MAX_FALLOS_IP=20                # fallos desde una misma IP antes de bloquearla
VENTANA_FALLOS_MIN=15
BLOQUEO_CUENTA_MIN=15
BLOQUEO_IP_MIN=30
BCRYPT_COSTO=12

# --- Inyección SQL ---
# bloquear  = el filtro rechaza la petición y la registra (recomendado)
# registrar = solo la registra; sirve para demostrar que, aun sin filtro,
#             las consultas parametrizadas no se dejan inyectar
FILTRO_SQLI=bloquear
