# Configuración de Kozmok. Copia este archivo como .env (en esta misma
# carpeta) y pon tus valores. El .env NO se sube a GitHub (.gitignore).

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kozmok
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_contraseña

# --- Servidor ---
PORT=3000
# 0.0.0.0 = también se abre desde celulares en la misma red Wi-Fi
# (la consola muestra la dirección). 127.0.0.1 = solo esta computadora.
HOST=0.0.0.0

# --- Sesiones ---
SESION_HORAS_CLIENTE=168        # 7 días
SESION_HORAS_EQUIPO=8
INACTIVIDAD_MIN_CLIENTE=2880    # se cierra tras 2 días sin uso
INACTIVIDAD_MIN_EQUIPO=120      # el panel se cierra tras 2 horas sin uso
# Casilla "Mantener sesión iniciada" del login de la tienda: la sesión
# sobrevive a cerrar el navegador y dura estos días (sin cierre por
# inactividad). Sin marcarla, la sesión se pierde al cerrar el navegador.
# El panel no tiene esa casilla: su sesión siempre se cierra al cerrar el
# navegador.
SESION_DIAS_RECORDAR_CLIENTE=30
# Pon 1 si la tienda se sirve por HTTPS (la cookie viaja solo cifrada)
COOKIE_SEGURA=0

# --- Fuerza bruta ---
MAX_FALLOS_CUENTA=5             # contraseñas equivocadas seguidas antes de bloquear la cuenta
MAX_FALLOS_IP=20                # fallos desde una misma IP antes de bloquearla
VENTANA_FALLOS_MIN=15
BLOQUEO_CUENTA_MIN=15
BLOQUEO_IP_MIN=30
BCRYPT_COSTO=12
# Enlaces de "¿Olvidaste tu contraseña?" que puede recibir una misma cuenta
# por hora. Al pasar el límite no se manda el correo (queda en Seguridad).
RECUPERACION_MAX_POR_HORA=10

# --- Verificación en dos pasos ---
# Al entrar, además de la contraseña se pide un código de una app
# autenticadora (Google/Microsoft Authenticator) o enviado al correo.
# En el panel es obligatoria: quien no eligió método recibe el código en su
# correo, así que el correo de cada cuenta del equipo debe ser real. En la
# tienda cada cliente la activa desde Seguridad. Si el correo (SMTP) no está
# configurado, el código por correo no se pide (para no dejar fuera al
# equipo) y queda un aviso en Seguridad del panel.
DOSF_PANEL_OBLIGATORIO=true

# --- Google reCAPTCHA ("No soy un robot") ---
# En iniciar sesión (tienda y panel), crear cuenta y recuperar contraseña.
# Claves en https://www.google.com/recaptcha/admin -> tipo "reCAPTCHA v2",
# opción "Casilla No soy un robot"; en Dominios agrega localhost y el dominio
# o IP con que abras la tienda. Vacías = sin captcha.
# Las pruebas de "npm run prueba:seguridad" no marcan la casilla: déjalas
# vacías mientras las corres.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Inyección SQL ---
# bloquear  = el filtro rechaza la petición y la registra (recomendado)
# registrar = solo la registra; sirve para demostrar que, aun sin filtro,
#             las consultas parametrizadas no se dejan inyectar
FILTRO_SQLI=bloquear

# --- Correo (Gmail) ---
# Bienvenida al crear cuenta, recuperación de contraseña y aviso de cambio
# de contraseña. Sin estos datos los correos solo se guardan en el panel
# (Seguridad → Correos enviados).
# SMTP_PASSWORD es una "contraseña de aplicación" de Google, NO la contraseña
# normal: en la cuenta de Gmail activa la verificación en dos pasos y luego
# entra a https://myaccount.google.com/apppasswords para generarla (16 letras).
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465                 # 465 = TLS directo; 587 = STARTTLS
CORREO_REMITENTE=Kozmok         # nombre que ve el cliente en su bandeja
# Dirección de la tienda para los enlaces de los correos (recuperar
# contraseña, boletín, avisos de favoritos y pedidos). Vacío = la dirección
# con la que se abrió la página, o http://localhost:3000 en los avisos
# automáticos; si pruebas desde el celular usa la IP de la red,
# p. ej. http://192.168.1.20:3000
URL_PUBLICA=
# Si usas un dominio (túnel de Cloudflare/ngrok o tu propio dominio), pon aquí
# la dirección completa para que los enlaces de los correos la usen, p. ej.:
#   URL_PUBLICA=https://kozmok.tudominio.com
# Con un dominio es OBLIGATORIA: vacía, los enlaces solo se arman con
# localhost o una IP de la red local (nunca con el dominio que mande quien
# hace la petición, para que no puedan robar enlaces de recuperación).
# Proxy de confianza para leer la IP real del visitante. Por defecto
# "loopback" (túnel o proxy en esta misma computadora); casi nunca se cambia.
# TRUST_PROXY=loopback

# --- Antifraude (los valores por defecto funcionan sin tocar nada) ---
# Inventario: una baja de un empleado (no administrador) desde estas piezas
# o este valor, o por robo, queda pendiente hasta que un admin la apruebe.
BAJA_UMBRAL_PIEZAS=3
BAJA_UMBRAL_VALOR=3000
# Clientes: piezas de un mismo producto por pedido y pedidos sin pagar abiertos.
MAX_PIEZAS_POR_PRODUCTO=10
MAX_PEDIDOS_SIN_PAGAR=3
# Monedero (reglamento en la tienda: terminos.html#monedero)
MONEDERO_RECARGA_MIN=50
MONEDERO_RECARGA_MAX=10000      # por recarga
MONEDERO_DIA_MAX=15000          # suma de recargas en 24 horas
MONEDERO_DIA_OPERACIONES=3      # recargas en 24 horas
MONEDERO_MES_MAX=30000          # suma de recargas en el mes
MONEDERO_SALDO_MAX=30000        # saldo + transferencias en camino
MONEDERO_TRANSFERENCIAS_PENDIENTES=2   # transferencias esperando confirmación a la vez
MONEDERO_TRANSFERENCIA_DIAS=3   # días para transferir antes de que la recarga se cancele
MONEDERO_AJUSTE_UMBRAL=500      # ajustes mayores necesitan segunda firma

# --- Datos de la empresa y transferencias (SPEI) ---
# Salen en el comprobante y en la ficha de pago. Sin SPEI_BANCO y una
# SPEI_CLABE válida (18 dígitos), la tienda no ofrece pagar ni recargar el
# monedero por transferencia. La CLABE puede llevar espacios. Si un valor
# lleva "#" (p. ej. el domicilio), escríbelo entre comillas; si no, lo que
# sigue al "#" se toma como comentario. Después de cambiarlos reinicia el
# servidor.
# MODO DE PRUEBA: la tienda no cobra por transferencia; solo muestra estos
# datos en la ficha y el pago se confirma a mano en el panel ("Marcar pago
# recibido" con cualquier folio). La CLABE de abajo es de prueba: tiene
# formato válido (012 = BBVA) pero no es de una cuenta real. Cámbiala por la
# CLABE real antes de recibir pagos de clientes.
# RFC y domicilio vacíos = no aparecen en el comprobante.
EMPRESA_NOMBRE=Kozmok
EMPRESA_RFC=
EMPRESA_DOMICILIO=
SPEI_BANCO=BBVA
SPEI_CLABE=012180000000000015
SPEI_BENEFICIARIO=Kozmok

# --- PayPal (pago con cuenta PayPal o con tarjeta) ---
# MODO DE PRUEBA (sandbox): no se cobra dinero real. Credenciales en
# developer.paypal.com > Apps & Credentials > Sandbox > tu app > Client ID / Secret.
# Sin estas dos líneas la opción "PayPal o tarjeta" aparece como no disponible.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MONEDA=MXN
# Minutos que un pedido queda apartado esperando el pago con PayPal.
PAYPAL_MINUTOS_PARA_PAGAR=60
# El modo real exige las DOS líneas; si falta una, sigue en sandbox.
# PAYPAL_MODO=live
# PAYPAL_PERMITIR_REAL=1

# --- Factura electrónica CFDI 4.0 (PAC: Facturama) ---
# MODO DE PRUEBA (sandbox): los CFDI no tienen validez fiscal. Crea una cuenta
# en https://apisandbox.facturama.mx y en su perfil pon el emisor de prueba
# (RFC EKU9003173C9) con sus sellos CSD de prueba. Sin estas líneas el botón
# "Facturar" no aparece.
FACTURAMA_USUARIO=
FACTURAMA_PASSWORD=
# Código postal del domicilio fiscal de la tienda (lugar de expedición)
FACTURA_LUGAR_EXPEDICION=
FACTURA_SERIE=KZ
# Días después del pago en que el cliente puede pedir su factura
FACTURA_DIAS_LIMITE=30
# El modo real exige las DOS líneas:
# FACTURAMA_MODO=live
# FACTURAMA_PERMITIR_REAL=1

# --- Devoluciones ---
DEVOLUCION_DIAS=30              # días después de la entrega para pedirla
DEVOLUCION_UMBRAL_ADMIN=3000    # reembolsos mayores: solo un administrador
# Dirección a la que el cliente envía el producto (va en el correo de aprobación)
DEVOLUCIONES_DIRECCION=
