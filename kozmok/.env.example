# Configuración de Kozmok.
# Copia este archivo como .env (en esta misma carpeta) y pon tus valores.
# El archivo .env NO se sube a GitHub (está en .gitignore): ahí van las
# contraseñas y claves reales de cada instalación.

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kozmok
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_contraseña

# --- Servidor ---
PORT=3000

# --- Sesiones ---
# Clave secreta con la que se firman las sesiones. Debe ser larga y
# aleatoria, y distinta en cada instalación. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si la cambias, todas las sesiones abiertas se cierran.
SESSION_SECRET=

# Duración de la sesión, en horas.
SESION_HORAS_EQUIPO=12
SESION_HORAS_CLIENTE=168
